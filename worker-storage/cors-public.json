{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://toova.net",
          "https://www.toova.net",
          "http://localhost:5173",
          "http://127.0.0.1:5173"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["*"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Type", "Accept-Ranges"],
      "maxAgeSeconds": 86400
    }
  ]
}
