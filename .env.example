# Copy to `.env.local` for local development (never commit `.env.local`).

# Pixal3D mesh generation — local dev only (formerly Trellis; same /generate API contract).
# Vite proxies /api/trellis/generate → ${PIXAL3D_UPSTREAM_ORIGIN or TRELLIS_UPSTREAM_ORIGIN}/generate
PIXAL3D_UPSTREAM_ORIGIN=http://3.81.50.95:8000
# TRELLIS_UPSTREAM_ORIGIN=http://3.81.50.95:8000

# Optional: skip the dev proxy and call Trellis (or an HTTPS BFF) directly.
# VITE_TRELLIS_GENERATE_URL=https://your-bff.example.com/api/trellis/generate

# Optional: production base path when testing a build locally (defaults to /).
# VITE_BASE_PATH=/
