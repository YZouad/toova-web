# Copy to `.env.local` for local development (never commit `.env.local`).

# Trellis mesh generation — local dev only.
# Vite proxies /api/trellis/* → ${TRELLIS_BFF_ORIGIN}/api/trellis/* (wake, status, generate).
# Do not point this at the raw EC2 IP — laptops cannot reach :8000 (security group + idle stop).
TRELLIS_BFF_ORIGIN=https://toova-bff.onrender.com

# Optional: skip the dev proxy and call the HTTPS BFF from the browser (needs CORS).
# VITE_TRELLIS_GENERATE_URL=https://toova-bff.onrender.com/api/trellis/generate
# VITE_THRIXEL_API_URL=https://toova-bff.onrender.com/api/thrixel

# Optional: production base path when testing a build locally (defaults to /).
# VITE_BASE_PATH=/

# Google Analytics 4 measurement ID (public; also set in GitHub Actions deploy env).
# This is the sole analytics destination — see .telemetry/tracking-plan.yaml.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Amazon Associates tag for search + multi-add cart URLs (defaults to toova-20).
# VITE_AMAZON_AFFILIATE_TAG=toova-20

# Optional: R2 ingest Worker (defaults to https://storage.toova.net).
# VITE_R2_STORAGE_URL=http://127.0.0.1:8787

# Static unfurl generation (CI / local after `npm run build`):
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SITE_ORIGIN=https://toova.net

# Billing edge functions (set via `supabase secrets set`, not Vite):
# BILLING_APP_ORIGIN=https://toova.net
# BILLING_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# App Store IAP + Sign in with Apple (also via `supabase secrets set`):
# APPSTORE_BUNDLE_ID=net.toova.app
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_CLIENT_ID=net.toova.app
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional local/dev only — never enable in production:
# APPSTORE_SKIP_JWS_VERIFY=1
